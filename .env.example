# docker-compose 部署用的环境变量模板：cp .env.example .env 后按需修改。
# 只有 docker-compose.yml 读这个文件；直接用 uvicorn 跑后端时读的是 backend/.env。

# PostgreSQL 容器密码（用户名固定为 admin，库名 agent_platform）
POSTGRES_PASSWORD=please-change-me

# JWT 签名密钥与模型 API Key 的 AES 加密密钥。
# AES_KEY 一旦用于加密入库就不能再改，改了库里已存的模型密钥会解不开。
SECRET_KEY=please-change-me-to-a-random-string
AES_KEY=please-change-me-32-bytes-key-0123456789

# MinIO 对象存储凭据（同时作为 MinIO 容器的 root 账号）
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# 向量模型（OpenAI 兼容协议）。留空 API_KEY 时退化为 hash 向量，仅做词面匹配。
# EMBEDDING_DIM 必须与 document_chunks.embedding 列的维度一致；已有数据的库不能随意改。
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# 入口治理。CORS_ORIGINS：浏览器直连后端时允许的源，逗号分隔（经 web 容器的 /api 同源反代时不涉及）。
# IP_DENYLIST：全局 IP 黑名单，逗号分隔的 IP 或 CIDR，命中一律 403。
# TRUSTED_PROXY_ENABLED：是否信任反代传来的 X-Real-IP / X-Forwarded-For。
# api 容器的 8000 端口对外映射时保持 false，否则直连 8000 的调用方可以伪造来源 IP。
CORS_ORIGINS=http://localhost:18056
IP_DENYLIST=
TRUSTED_PROXY_ENABLED=false

# 模型调用熔断：SDK 重试归零，连续失败达阈值后在开启秒数内快速失败（503），到期放行一个探测。阈值 0 关闭熔断。
MODEL_MAX_RETRIES=0
MODEL_BREAKER_FAIL_THRESHOLD=5
MODEL_BREAKER_OPEN_SECONDS=30

# RAG 查询改写：开启后每条消息多一次模型调用（DeepSeek 类模型实测 4～9 秒），默认关闭；开启时超时秒数内没结果就用原问题检索。
RAG_QUERY_REWRITE_ENABLED=false
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=3

# Rerank 模型（可选）：PROVIDER 空 = 词法重排；cohere = Cohere / Jina / TEI / vLLM / oMLX 共用的 POST /rerank；dashscope = 阿里云百炼。
# 调用失败自动退回词法并在 /system/status 报降级。阈值按 Qwen3-Reranker 标定，换模型后按评测页分数调整。
RERANK_PROVIDER=
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT=5
RERANK_CANDIDATES=12
RERANK_MIN_SCORE=0.02
RERANK_GAP_RATIO=0.02

# 入口限流：按自然分钟固定窗口计数，Redis 不可用时放行并在 /system/status 报降级。
# 单个 API Key 可在管理页覆盖自己的每分钟上限。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_KEY_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_IP_PER_MINUTE=20
