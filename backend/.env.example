APP_NAME=Agent Platform
SECRET_KEY=please-change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AES_KEY=please-change-me-32-bytes-key-0123456789
INITIAL_ADMIN_PASSWORD=
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agent_platform
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kb-docs
MINIO_TIMEOUT=120
MODEL_HTTP_TIMEOUT=120
MODEL_MAX_RETRIES=0
MODEL_BREAKER_FAIL_THRESHOLD=5
MODEL_BREAKER_OPEN_SECONDS=30
RAG_QUERY_REWRITE_ENABLED=false
RAG_QUERY_REWRITE_TIMEOUT_SECONDS=3
CHAT_MESSAGE_MAX_CHARS=8000
TOOL_CALL_MAX_ROUNDS=8
KB_UPLOAD_MAX_MB=200
INGEST_CONCURRENCY=1
INGEST_STALL_SECONDS=180
INGEST_AUTO_RESUME=true
INGEST_BATCH_SIZE=100
INGEST_EMBED_CONCURRENCY=4
INGEST_WRITE_BUFFER=4
EMBEDDING_REQUEST_SIZE=20
RERANK_PROVIDER=
RERANK_API_BASE=
RERANK_API_KEY=
RERANK_MODEL=
RERANK_TIMEOUT=5
RERANK_CANDIDATES=12
RERANK_MIN_SCORE=0.02
RERANK_GAP_RATIO=0.02
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
CORS_ORIGINS=http://localhost:18056
IP_DENYLIST=
TRUSTED_PROXY_ENABLED=false
PUBLIC_BASE_URL=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_KEY_PER_MINUTE=60
RATE_LIMIT_USER_PER_MINUTE=300
RATE_LIMIT_IP_PER_MINUTE=20
# Redis 故障时改为"拒绝"的 scope 名单（逗号分隔）：share / share_v / ip 是公开入口，默认 fail-closed；
# ak（API Key）/ user（登录用户）是已鉴权的内部调用，默认 fail-open。理由见 app/core/rate_limiter.py 模块说明。
RATE_LIMIT_FAIL_CLOSED_SCOPES=share,share_v,ip
SHARE_VISITOR_PER_MINUTE=10
# 定时任务漏跑的容忍窗口（秒）：APScheduler 默认 1 秒太紧，重启或线程卡顿超过 1 秒的触发会被静默丢弃。
# 错过触发的会在运行记录里留一条 failed 记录（可在任务列表与运行记录里看到）。
SCHEDULE_MISFIRE_GRACE_SECONDS=60
# 多实例选主：共享库 + 多后端时只有抢到 PostgreSQL advisory lock 的实例执行定时任务。
# 单进程部署可设为 false（等于本进程必为主）。
SCHEDULER_LEADER_ELECTION_ENABLED=true
# 卡住运行的处置阈值（分钟）：超过这么久仍是 running 的运行视为进程被杀后没收尾的幽灵记录，
# 允许在运行记录页标记为失败并回收检查点（docs/15 OP-10）。工作台的 stuck_running 也按它计数。
STUCK_RUN_MINUTES=60
# 工作流检查点回收：终态运行的检查点本该在收尾时删掉，这里兜底清残留的（进程被杀、清理失败），
# 宽限期避免与"刚收尾、正在删"的运行抢同一份数据。
CHECKPOINT_TERMINAL_GRACE_HOURS=24
# awaiting_review 的检查点是审批后 resume 的依据，不能按终态清；只清超过这么多天仍未审批的
# （同时把该运行收尾为 failed，否则审批一提交会从空 state 重跑）。
CHECKPOINT_AWAITING_REVIEW_RETENTION_DAYS=7
# 交互式文档开关（docs/09 第三梯队）：默认关闭，/docs、/redoc、/openapi.json 三个入口一起不可用。
# 本地开发要看文档时设为 true；生产不要开（会把全部路由与请求体结构公开出去）。
API_DOCS_ENABLED=false
# 非流式（blocking）对话的总超时秒数（docs/15 PB-10）：收齐全部事件才返回 JSON，必须有上界。
# 要大于 MODEL_HTTP_TIMEOUT（单次模型调用 120 秒）+ 工具轮次，否则正常的一轮工具调用会被误判超时。
CHAT_BLOCKING_TIMEOUT_SECONDS=300
# 工作流对外运行的阻塞超时秒数（docs/15 WF-05）：超过后返回 202 + run_id，让调用方轮询，
# 后台继续跑完（只放弃等待、不取消任务）。
WORKFLOW_BLOCKING_TIMEOUT_S=60
# 同时执行的工作流数上限（进程内）：满了返回 429 并说明当前并发与上限。
# 不设上限会让每个请求各占一个线程，长流程叠加后把连接池与内存一起打满。
WORKFLOW_MAX_CONCURRENCY=4
TEST_ADMIN_PASSWORD=
